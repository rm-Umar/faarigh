<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="FAARIGH"
            android:textColor="#FF8D6E63"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_screen_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="0m"
            android:textColor="#FF5D4037"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Divider — use TextView instead of View (View blocked in RemoteViews API 31+) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#FF8D6E63"
        android:text="" />

    <!-- Stats Row — weight fills remaining space above module row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Conscious: "
            android:textColor="#FF8D6E63"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_choices"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:fontFamily="monospace"
            android:text="0"
            android:textColor="#FF6B9E5B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Intentional: "
            android:textColor="#FF8D6E63"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_intentional"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="0%"
            android:textColor="#FF9C78B8"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Module Status Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="App Pause "
            android:textColor="#FF8D6E63"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_dot_app_pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u25CF"
            android:textColor="#FFBDBDBD"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="  |  "
            android:textColor="#FF8D6E63"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Shorts "
            android:textColor="#FF8D6E63"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_dot_shorts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u25CF"
            android:textColor="#FFBDBDBD"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="  |  "
            android:textColor="#FF8D6E63"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="DNS "
            android:textColor="#FF8D6E63"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_dot_dns"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u25CF"
            android:textColor="#FFBDBDBD"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
